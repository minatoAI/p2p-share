// 由 CMake 生成的资源配置：网页和图标全部编进 exe，旁边不需要任何文件。
// 路径必须是绝对路径且用正斜杠：rc.exe 里反斜杠是转义符。

// 真正的图标资源。托盘自己在内存里解析 RCDATA 里的 .ico，但开始菜单/桌面
// 快捷方式只认 RT_GROUP_ICON，没有这一行快捷方式就是白纸图标。
101 ICON "@TRAY_ICON_STATIC@"

201 RCDATA "@TRAY_WEB_HTML@"
202 RCDATA "@TRAY_WEB_CSS@"
203 RCDATA "@TRAY_WEB_JS@"
204 RCDATA "@TRAY_WEB_QRCODE@"
205 RCDATA "@TRAY_WEB_JSQR@"
301 RCDATA "@TRAY_ICON_STATIC@"
302 RCDATA "@TRAY_ICON_BADGE@"
303 RCDATA "@TRAY_ICON_1@"
304 RCDATA "@TRAY_ICON_2@"
305 RCDATA "@TRAY_ICON_3@"
306 RCDATA "@TRAY_ICON_4@"
307 RCDATA "@TRAY_ICON_5@"
308 RCDATA "@TRAY_ICON_6@"
309 RCDATA "@TRAY_ICON_7@"
310 RCDATA "@TRAY_ICON_8@"
311 RCDATA "@TRAY_ICON_9@"
312 RCDATA "@TRAY_ICON_10@"
313 RCDATA "@TRAY_ICON_11@"
314 RCDATA "@TRAY_ICON_12@"
315 RCDATA "@TRAY_ICON_13@"
316 RCDATA "@TRAY_ICON_14@"
317 RCDATA "@TRAY_ICON_15@"
